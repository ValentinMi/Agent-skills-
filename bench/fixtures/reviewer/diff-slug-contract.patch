+// Renamed export + wrong signature: default export taking (input, sep)
+export default function toSlug(input: string, sep = "-"): string {
+  return input
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, sep)
+    .replace(new RegExp(`^${sep}+|${sep}+$`, "g"), "");
+}
