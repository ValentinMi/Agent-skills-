# Copy to bench/config.env and `source` it (or export these) before running.
# All optional — sensible defaults are baked in.

# Where your local model serves the Ollama chat API.
export OLLAMA_URL="http://localhost:11434/api/chat"

# The model under test. Must be pulled locally (e.g. `ollama pull qwen2.5-coder:7b`).
# Set to "mock" to exercise the whole pipeline with no backend.
export BENCH_MODEL="qwen2.5-coder:7b"

# Grader model for llm_judge checks. Defaults to BENCH_MODEL; point it at a
# stronger local model (or a different endpoint) for more reliable grading.
export JUDGE_MODEL="qwen2.5-coder:7b"
export JUDGE_URL="http://localhost:11434/api/chat"

# Per-request timeout in seconds (local models can be slow on first token).
export BENCH_TIMEOUT="300"
